{
  "name": "my-helper-bot",
  "version": "1.0.0",
  "description": "A powerful custom Telegram bot for personal assistance",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "webhook:info": "tsx scripts/webhook-manager.ts info",
    "webhook:delete": "tsx scripts/webhook-manager.ts delete",
    "webhook:set": "tsx scripts/webhook-manager.ts set",
    "codex:notify": "tsx scripts/codex-notify-bridge.ts",
    "codex:notify:daemon": "tsx scripts/codex-notify-bridge.ts --daemon",
    "codex:notify:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-codex-notify.ps1"
  },
  "keywords": [
    "telegram",
    "bot",
    "assistant"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^1.42.0",
    "@langchain/community": "^1.1.21",
    "@langchain/core": "^1.1.29",
    "@langchain/google-genai": "^2.1.23",
    "@supabase/supabase-js": "^2.39.7",
    "dotenv": "^16.4.1",
    "langchain": "^1.2.28",
    "pgvector": "^0.2.1",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "eslint": "^8.56.0",
    "node-notifier": "^10.0.1",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "ignore": "^7.0.5"
  }
}