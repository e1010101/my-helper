{
  "name": "my-helper-bot",
  "version": "1.0.0",
  "description": "A powerful custom Telegram bot for personal assistance",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src scripts tests --ext .ts",
    "type-check": "tsc -p tsconfig.check.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "webhook:info": "tsx scripts/webhook-manager.ts info",
    "webhook:delete": "tsx scripts/webhook-manager.ts delete",
    "webhook:set": "tsx scripts/webhook-manager.ts set",
    "db:migrate": "tsx scripts/db-migrate.ts"
  },
  "keywords": [
    "telegram",
    "bot",
    "assistant"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^1.42.0",
    "@supabase/supabase-js": "^2.39.7",
    "dotenv": "^16.4.1",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "eslint": "^8.56.0",
    "node-notifier": "^10.0.1",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
