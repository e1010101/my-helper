# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_from_@BotFather

# Admin Configuration (your Telegram user ID for admin commands)
# To find your user ID, message @userinfobot on Telegram
ADMIN_USER_ID=your_telegram_user_id

# AI provider. Exactly one of the keys below must be set, or pin the choice
# explicitly with AI_PROVIDER=deepseek|gemini.
AI_PROVIDER=deepseek

# DeepSeek (default provider)
DEEPSEEK_API_KEY=your_deepseek_api_key
# deepseek-chat supports function calling, which the assistant tools require.
# deepseek-reasoner is not recommended here.
DEEPSEEK_MODEL=deepseek-chat

# Google Gemini (alternative provider)
# GEMINI_API_KEY=your_gemini_api_key

BOT_PERSONALITY_PROMPT="You are a helpful and friendly personal assistant bot for Telegram. Provide concise and useful answers."

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# REQUIRED for the assistant features: conversations, facts, reminders and
# pending confirmations have Row Level Security enabled, so they only answer
# this key. Find it under Project Settings -> API -> service_role.
# Never expose it to a browser or client app.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database connection string, used ONLY by `npm run db:migrate` to apply
# docs/database-schema.sql. Not needed to run the bot.
# Supabase: Project Settings -> Database -> Connection string -> URI.
# Prefer the "Connection pooling" (Supavisor) URI if your network lacks IPv6.
# DATABASE_URL=postgresql://postgres.abcdefghijklm:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Timezone used for reminders and "today/tomorrow" parsing (IANA name).
# Defaults to the host timezone when unset.
TIMEZONE=Asia/Singapore

# Environment (development or production)
NODE_ENV=development

# Port for the HTTP server (health endpoint, and webhook when enabled).
# Hosting platforms such as Railway inject PORT automatically; WEBHOOK_PORT is
# only a fallback for local use.
# PORT=3000

# Optional: Webhook configuration (leave empty for polling mode)
# For production deployment on Railway, uncomment and set these:
# WEBHOOK_DOMAIN=your-app.railway.app
# WEBHOOK_PORT=3000
# Shared secret Telegram sends back in the X-Telegram-Bot-Api-Secret-Token
# header, so only Telegram can post updates to /webhook.
# Allowed characters: A-Z, a-z, 0-9, "_" and "-" (1-256 chars).
# WEBHOOK_SECRET=change_me_to_a_long_random_string

# Optional: unlocks the usage dashboard at /dashboard, which is otherwise
# disabled entirely. Falls back to WEBHOOK_SECRET when unset, so a deployment
# that already has a webhook secret needs nothing new. Treat it as a password:
# the page shows your usage data on a publicly resolvable domain.
# DASHBOARD_TOKEN=change_me_to_another_long_random_string

# Optional: how many days the dashboard covers (default 30, maximum 365).
# DASHBOARD_DAYS=30
